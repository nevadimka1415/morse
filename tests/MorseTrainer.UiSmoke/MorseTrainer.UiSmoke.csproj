<Project Sdk="Microsoft.NET.Sdk">
  <!-- Дымовой тест интерфейса Windows: поднимает настоящее WPF-окно, поэтому собирается и запускается только на Windows -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MorseTrainer.UiSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MorseTrainer/MorseTrainer.csproj" />
  </ItemGroup>
</Project>
