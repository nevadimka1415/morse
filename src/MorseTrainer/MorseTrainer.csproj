<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Только для значка в области уведомлений (уведомление Windows о тренировке) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MorseTrainer</AssemblyName>
    <RootNamespace>MorseTrainer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MorseTrainer.ico</ApplicationIcon>
    <Version>2.6.0</Version>
    <Authors>Morse Trainer contributors</Authors>
    <Product>Morse Trainer</Product>
    <Description>Offline Morse code trainer for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Voice\*.wav" />
  </ItemGroup>
  <ItemGroup>
    <!-- Пространства имён WinForms не подключаются неявно: иначе Application, MessageBox, Button двусмысленны с WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Дымовой UI-тест обращается к элементам окна по x:Name (в WPF они internal) -->
    <InternalsVisibleTo Include="MorseTrainer.UiSmoke" />
  </ItemGroup>
</Project>
