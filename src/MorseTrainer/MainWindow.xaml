<Window x:Class="MorseTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MorseTrainer.Localization"
        Title="Morse Trainer"
        Width="1240" Height="860" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_OnLoaded"
        Closing="Window_OnClosing"
        KeyDown="Window_OnKeyDown"
        KeyUp="Window_OnKeyUp"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewTextInput="Window_OnPreviewTextInput">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource PrimaryBrush}" MouseLeftButtonUp="Logo_OnMouseLeftButtonUp">
                <!-- Знак «· — —» (буква В), как на иконке; фигурами — символы тире в шрифте сливаются в одну черту -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#10251D" />
                    <Rectangle Width="13" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#10251D" Margin="2,0,0,0" VerticalAlignment="Center" />
                    <Rectangle Width="13" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#10251D" Margin="2,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="Morse Trainer" FontSize="25" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="{loc:Loc 'Тренировка и изучение азбуки Морзе'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="LanguageCombo" Width="150" SelectedIndex="0" Margin="0,0,10,0"
                          SelectionChanged="LanguageCombo_OnSelectionChanged">
                    <ComboBoxItem Content="{loc:Loc 'Язык: системный'}" />
                    <ComboBoxItem Content="{loc:Loc 'Язык: русский'}" />
                    <ComboBoxItem Content="{loc:Loc 'Язык: English'}" />
                </ComboBox>
                <ComboBox x:Name="ThemeCombo" Width="145" SelectedIndex="0"
                          SelectionChanged="ThemeCombo_OnSelectionChanged">
                    <ComboBoxItem Content="{loc:Loc 'Тема: системная'}" />
                    <ComboBoxItem Content="{loc:Loc 'Тема: тёмная'}" />
                    <ComboBoxItem Content="{loc:Loc 'Тема: светлая'}" />
                </ComboBox>
                <Button x:Name="CheckUpdatesButton" Content="{loc:Loc 'Обновления'}" Margin="10,0,0,0" Padding="12,6"
                        ToolTip="{loc:Loc 'Проверить, вышла ли новая версия на GitHub. Интернет нужен только для этой проверки.'}"
                        Click="CheckUpdatesButton_OnClick" />
                <Border Background="{DynamicResource PrimaryDarkBrush}" CornerRadius="13" Padding="13,7" Margin="10,0,0,0">
                    <TextBlock Text="OFFLINE" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Плашка «давно не занимались»: по истории при запуске -->
        <Border x:Name="NudgeBanner" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource PrimaryDarkBrush}"
                CornerRadius="12" Padding="16,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NudgeText" Text=" " Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="NudgeStartButton" Grid.Column="1" Content="{loc:Loc 'Начать тренировку'}" Click="NudgeStartButton_OnClick"
                        Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="12,0,8,0" />
                <Button x:Name="NudgeCloseButton" Grid.Column="2" Content="✕" Click="NudgeCloseButton_OnClick" Padding="10,6"
                        ToolTip="{loc:Loc 'Скрыть'}" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="3">
            <TabItem Header="{loc:Loc 'Тренировка'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TrainingPanelColumn" Width="380" />
                        <ColumnDefinition x:Name="TrainingPanelSpacer" Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TrainingPanel" Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc 'Параметры задания'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" />

                                <TextBlock Text="{loc:Loc 'Что тренировать'}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Margin="-3,0,-3,6">
                                    <Button x:Name="ModeLettersButton" Content="{loc:Loc 'Все буквы'}" Tag="0" Click="ModeButton_OnClick" Padding="8,8" Margin="3" />
                                    <Button x:Name="ModeDigitsButton" Content="{loc:Loc 'Все цифры'}" Tag="1" Click="ModeButton_OnClick" Padding="8,8" Margin="3" />
                                    <Button x:Name="ModeBothButton" Content="{loc:Loc 'Буквы и цифры'}" Tag="2" Click="ModeButton_OnClick" Padding="8,8" Margin="3" />
                                    <Button x:Name="ModeCustomButton" Content="{loc:Loc 'Свои символы'}" Tag="4" Click="ModeButton_OnClick" Padding="8,8" Margin="3" />
                                </UniformGrid>
                                <TextBlock x:Name="ModeHintText" Text=" " Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,15" />

                                <Border x:Name="CustomSymbolsPanel" Visibility="Collapsed" Background="{DynamicResource CardAltBrush}"
                                        CornerRadius="10" Padding="12" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc 'Собственный набор'}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SelectedSymbolsSummaryText" Text="{loc:Loc 'Ничего не выбрано'}"
                                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,9" />
                                        <Button Content="{loc:Loc 'Выбрать символы'}" Click="SelectSymbolsButton_OnClick" Padding="12,7" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{loc:Loc 'Количество групп'}" VerticalAlignment="Center" Padding="0" />
                                    <TextBox x:Name="GroupCountText" Grid.Column="1" Text="10" HorizontalContentAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="GroupHintText" Text="{loc:Loc 'В каждой группе 5 символов'}" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" Margin="0,-9,0,15" />

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="{loc:Loc 'Скорость знака'}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="SpeedValueText" Text="{loc:Loc '60 знаков/мин'}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="20" Maximum="300" Value="60" TickFrequency="5"
                                        IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,17" />

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="{loc:Loc 'Тональность'}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="FrequencyValueText" Text="{loc:Loc '700 Гц'}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="FrequencySlider" Minimum="300" Maximum="1200" Value="700" TickFrequency="50"
                                        IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,17" />

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="{loc:Loc 'Громкость'}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="VolumeValueText" Text="70%" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="70" TickFrequency="5"
                                        IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,17" />

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="{loc:Loc 'Пауза между символами'}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="CharacterGapValueText" Text="{loc:Loc '3 точки'}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="CharacterGapSlider" Minimum="3" Maximum="20" Value="3" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,17" />

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="{loc:Loc 'Пауза между группами'}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="GroupGapValueText" Text="{loc:Loc '7 точек'}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="GroupGapSlider" Minimum="7" Maximum="30" Value="7" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,10" />
                                <Button x:Name="GenerateButton" Content="{loc:Loc 'Сгенерировать задание'}" Style="{StaticResource PrimaryButton}"
                                        Click="GenerateButton_OnClick" Padding="16,13" />
                                <TextBlock Text="{loc:Loc 'Ctrl+G — создать новое задание'}" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <Button x:Name="ExamButton" Content="{loc:Loc 'Экзамен'}" Click="ExamButton_OnClick" Padding="12,9" Margin="0,8,0,0"
                                        ToolTip="{loc:Loc 'Экзамен: задание с текущими параметрами, ограниченное число прослушиваний и лимит времени (в дополнительных настройках), ответ скрыт, идёт время. После проверки — протокол и запись в истории с пометкой.'}" />
                                <Button x:Name="DrillButton" Content="{loc:Loc 'Повторить сложные символы'}" Click="DrillButton_OnClick" Padding="12,9" Margin="0,8,0,0"
                                        ToolTip="{loc:Loc 'Задание только из символов, в которых вы чаще всего ошибались в последних 100 заданиях, и похожих на них по коду. Сложные звучат втрое чаще.'}" />
                                <Button x:Name="AdvancedButton" Content="{loc:Loc 'Дополнительные настройки ▾'}" Click="AdvancedButton_OnClick"
                                        Padding="12,8" Margin="0,16,0,0"
                                        ToolTip="{loc:Loc 'Профили, алфавит и особые режимы, пресет Фарнсворта, помехи, авто-скорость, сигнал Ж Ж Ж, правила экзамена'}" />
                                <!-- Всё, что нужно редко, — под кнопкой, чтобы не мешало и не путало -->
                                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Label Content="{loc:Loc 'Профиль настроек'}" />
                                    <ComboBox x:Name="ProfileCombo" IsEditable="True" IsTextSearchEnabled="True"
                                              SelectionChanged="ProfileCombo_OnSelectionChanged" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{loc:Loc 'Сохранить профиль'}" Click="SaveProfileButton_OnClick" Padding="10,7" />
                                        <Button Grid.Column="2" Content="{loc:Loc 'Удалить'}" Click="DeleteProfileButton_OnClick" Padding="10,7" />
                                    </Grid>
                                    <Grid Margin="0,-7,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{loc:Loc 'Экспорт…'}" Click="ExportProfilesButton_OnClick" Padding="10,7"
                                                ToolTip="{loc:Loc 'Сохранить все профили в файл, чтобы перенести на другой компьютер или телефон'}" />
                                        <Button Grid.Column="2" Content="{loc:Loc 'Импорт…'}" Click="ImportProfilesButton_OnClick" Padding="10,7"
                                                ToolTip="{loc:Loc 'Загрузить профили из файла; одноимённые профили будут заменены'}" />
                                    </Grid>

                                    <Label Content="{loc:Loc 'Алфавит'}" />
                                    <ComboBox x:Name="AlphabetCombo" SelectedIndex="0" Margin="0,0,0,15"
                                              SelectionChanged="AlphabetCombo_OnSelectionChanged">
                                        <ComboBoxItem Content="{loc:Loc 'Русский'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Латинский'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Русский и латинский'}" />
                                    </ComboBox>

                                    <Label Content="{loc:Loc 'Состав задания'}" />
                                    <ComboBox x:Name="ContentModeCombo" SelectedIndex="2" Margin="0,0,0,15"
                                              SelectionChanged="ContentModeCombo_OnSelectionChanged">
                                        <ComboBoxItem Content="{loc:Loc 'Только буквы'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Только цифры'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Буквы и цифры'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Буквы, цифры и знаки'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Выбранные символы'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Метод Коха: по уровням'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Слова'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Позывные'}" />
                                        <ComboBoxItem Content="{loc:Loc 'Q-код и сокращения'}" />
                                    </ComboBox>

                                    <Border x:Name="KochPanel" Visibility="Collapsed" Background="{DynamicResource CardAltBrush}"
                                            CornerRadius="10" Padding="12" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc 'Метод Коха'}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="KochSummaryText" Text="{loc:Loc 'Уровень 2'}" Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,5,0,6" />
                                            <Slider x:Name="KochLevelSlider" Minimum="2" Maximum="42" Value="2" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" ValueChanged="KochLevelSlider_OnValueChanged" />
                                            <TextBlock Text="{loc:Loc 'Новый символ добавляйте, когда точность держится на 90% и выше. Последний добавленный звучит чаще остальных.'}"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="FarnsworthButton" Content="{loc:Loc 'Пресет Фарнсворта'}" Click="FarnsworthButton_OnClick"
                                            Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,14"
                                            ToolTip="{loc:Loc 'Символы не медленнее 90 знаков/мин, паузы 9 точек между символами и 21 между группами: ухо запоминает ритм знака, а не считает точки.'}" />
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="{loc:Loc 'Помехи (шум)'}" Foreground="{DynamicResource MutedTextBrush}"
                                                   ToolTip="{loc:Loc 'Белый шум приёмника, медленные замирания и уход частоты, как в эфире. 0 — чистый сигнал.'}" />
                                        <TextBlock x:Name="NoiseValueText" Text="0%" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="NoiseSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                                            IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,17" />
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="{loc:Loc 'Замирания (QSB)'}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock x:Name="QsbValueText" Text="0%" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="QsbSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                                            IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,17" />
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="{loc:Loc 'Дрейф тона'}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock x:Name="DriftValueText" Text="{loc:Loc '±0 Гц'}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="DriftSlider" Minimum="0" Maximum="50" Value="0" TickFrequency="5"
                                            IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,17" />
                                    <CheckBox x:Name="EmphasizeProblemsCheckBox" Content="{loc:Loc 'Чаще повторять символы с ошибками'}"
                                              IsChecked="True" Margin="0,0,0,12"
                                              ToolTip="{loc:Loc 'Символы, в которых вы ошибались (по истории тренировок), попадают в задание втрое чаще.'}" />

                                    <CheckBox x:Name="AutoSpeedCheckBox" Content="{loc:Loc 'Авто-скорость'}" IsChecked="False" Margin="0,0,0,12"
                                              ToolTip="{loc:Loc 'Лестница скорости: два задания подряд с точностью от 90 % — скорость +5 знаков/мин, задание с точностью ниже 70 % — сразу −5.'}" />
                                    <CheckBox x:Name="PlayStartSignalCheckBox" Content="{loc:Loc 'Перед заданием проигрывать Ж Ж Ж'}"
                                              IsChecked="True" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="{loc:Loc 'Пауза после Ж Ж Ж'}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock x:Name="StartPauseValueText" Text="{loc:Loc '21 точка'}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="StartPauseSlider" Minimum="7" Maximum="60" Value="21" TickFrequency="1"
                                            IsSnapToTickEnabled="True" ValueChanged="SettingSlider_OnValueChanged" Margin="0,0,0,18" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc 'Экзамен: прослушиваний'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                            <ComboBox x:Name="ExamPlaybacksCombo" SelectedIndex="0">
                                                <ComboBoxItem Content="1" />
                                                <ComboBoxItem Content="2" />
                                                <ComboBoxItem Content="3" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc 'Лимит времени'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                            <ComboBox x:Name="ExamLimitCombo" SelectedIndex="0"
                                                      ToolTip="{loc:Loc 'Когда время выйдет, ответ проверится автоматически'}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ReminderCheckBox" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Checked="ReminderOption_OnChanged" Unchecked="ReminderOption_OnChanged"
                                                  ToolTip="{loc:Loc 'Каждый день в выбранное время, если вы ещё не занимались. Уведомление приходит, пока программа открыта (можно свернуть).'}">
                                            <TextBlock Text="{loc:Loc 'Напоминать уведомлением Windows'}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <ComboBox x:Name="ReminderTimeCombo" Grid.Column="1" SelectionChanged="ReminderOption_OnChanged" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc 'Тренировка'}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TaskMetaText" Text="{loc:Loc 'Подготавливаем задание…'}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                    <Button x:Name="QuickGenerateButton" Content="{loc:Loc 'Новое задание'}" Click="GenerateButton_OnClick"
                                            Visibility="Collapsed" Padding="10,5" Margin="0,0,8,0" ToolTip="Ctrl+G" />
                                    <Button x:Name="TogglePanelButton" Content="{loc:Loc '◀ Параметры'}" Click="TogglePanelButton_OnClick"
                                            Padding="10,5" Margin="0,0,8,0"
                                            ToolTip="{loc:Loc 'Скрыть или показать панель параметров: на маленьком экране задание получает всю ширину'}" />
                                    <Border x:Name="StatusBadge" Background="{DynamicResource CardAltBrush}" CornerRadius="12"
                                            Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusBadgeText" Text="{loc:Loc 'НЕ ГОТОВО'}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontWeight="SemiBold" FontSize="10" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{loc:Loc 'Текст задания'}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <!-- Во время прослушивания: какая группа звучит (для записи на бумаге) -->
                                        <TextBlock x:Name="GroupCounterText" Text=" " Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                        <Button x:Name="ToggleAnswerButton" Content="{loc:Loc 'Показать'}" HorizontalAlignment="Right"
                                                Padding="12,5" Click="ToggleAnswerButton_OnClick" IsEnabled="False" />
                                    </Grid>
                                    <TextBlock x:Name="AnswerDisplayText" Grid.Row="2" Text="••••• ••••• •••••"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlayButton" Content="{loc:Loc '▶  Слушать'}" Style="{StaticResource PrimaryButton}"
                                        Click="PlayButton_OnClick" IsEnabled="False" />
                                <Button x:Name="StopButton" Grid.Column="2" Content="{loc:Loc '■  Стоп'}" Click="StopButton_OnClick" IsEnabled="False" />
                                <Button x:Name="RepeatButton" Grid.Column="4" Content="{loc:Loc '↻  Повторить'}" Click="PlayButton_OnClick" IsEnabled="False" />
                                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                    <ProgressBar x:Name="PlaybackProgress" Height="6" Minimum="0" Maximum="100" Value="0" />
                                    <TextBlock x:Name="PlaybackStatusText" Text="{loc:Loc 'Ожидание задания'}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- Обычно группы записывают на бумаге и сверяют с текстом задания; ввод ответа — по желанию, под кнопкой.
                                 С вводом появляются точность, попытки и вкладка «Прогресс»; экзамен и шаги курса открывают ввод сами -->
                            <Grid Grid.Row="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PaperHintText" Text="{loc:Loc 'Записывайте на бумаге, затем нажмите «Показать» и сверьте.'}"
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock x:Name="AnswerPromptText" Text="{loc:Loc 'Введите то, что услышали'}" Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                    <Button x:Name="AnswerInputButton" Grid.Column="1" Content="{loc:Loc 'Проверить вводом ▾'}" Click="AnswerInputButton_OnClick"
                                            Padding="10,2" FontSize="12" ToolTip="{loc:Loc 'Поле для ответа с клавиатуры: точность, ошибки и вкладка «Прогресс» с историей. Выбор запоминается.'}" />
                                </Grid>
                                <Grid x:Name="AnswerInputPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="UserAnswerText" AcceptsReturn="True" TextWrapping="Wrap" Padding="10,4"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="18" IsEnabled="False" />
                                    <Grid Grid.Row="2">
                                        <Button x:Name="CheckAnswerButton" Content="{loc:Loc 'Проверить ответ'}" Style="{StaticResource PrimaryButton}"
                                                Click="CheckAnswerButton_OnClick" IsEnabled="False" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="ResultDetailsText" Text="{loc:Loc 'Пробелы между группами при проверке не учитываются'}"
                                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" MaxWidth="430" FontSize="11" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="AnswerStatsGrid" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc 'ТОЧНОСТЬ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                            <TextBlock x:Name="AccuracyText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc 'ПОПЫТКИ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                            <TextBlock x:Name="AttemptsText" Text="0" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc 'СЛОЖНЫЕ СИМВОЛЫ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                            <TextBlock x:Name="ProblemSymbolsText" Text="—" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Button x:Name="SaveTaskButton" Grid.Column="2" Content="{loc:Loc 'Сохранить TXT'}" Click="SaveTaskButton_OnClick" IsEnabled="False" />
                                <Button x:Name="ExportWavButton" Grid.Column="4" Content="{loc:Loc 'Экспорт WAV'}" Click="ExportWavButton_OnClick" IsEnabled="False" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc 'Обучение'}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="16">
                        <!-- Какие символы показать: кнопки вместо выпадающего списка, выбранная подсвечена (как на телефоне) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LearningRussianButton" Content="{loc:Loc 'Русские буквы'}" Tag="0" Click="LearningAlphabetButton_OnClick" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="LearningLatinButton" Content="{loc:Loc 'Латинские буквы'}" Tag="1" Click="LearningAlphabetButton_OnClick" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="LearningBothButton" Content="{loc:Loc 'Русские и латинские'}" Tag="2" Click="LearningAlphabetButton_OnClick" Padding="12,7" Margin="0,0,6,0" />
                                <Button x:Name="LearningDigitsButton" Content="{loc:Loc 'Цифры'}" Tag="3" Click="LearningAlphabetButton_OnClick" Padding="12,7" />
                            </StackPanel>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBox x:Name="LearningSearchText" Grid.Column="1" TextChanged="LearningFilter_OnTextChanged"
                                         ToolTip="{loc:Loc 'Поиск по букве или напеву'}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Курс «С нуля до 60 зн/мин»: текущий шаг и кнопки, которые ставят нужные настройки -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CourseTitleText" Text="{loc:Loc 'Курс «С нуля до 60 зн/мин»'}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="CourseDetailsText" Text=" " Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock x:Name="CourseStatusText" Text=" " FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="420">
                                <Button x:Name="CourseStartButton" Content="{loc:Loc 'Начать курс'}" Click="CourseStartButton_OnClick"
                                        Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,4,8,4" />
                                <Button x:Name="CourseNextButton" Content="{loc:Loc 'Следующий шаг'}" Click="CourseNextButton_OnClick"
                                        Padding="12,7" Margin="0,4,8,4" />
                                <Button x:Name="CourseBookButton" Content="{loc:Loc '📖 Как устроен курс'}" Click="CourseBookButton_OnClick"
                                        Padding="12,7" Margin="0,4,8,4" />
                                <Button x:Name="CourseResetButton" Content="{loc:Loc 'Сбросить курс'}" Click="CourseResetButton_OnClick"
                                        Padding="12,7" Margin="0,4,0,4" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="365" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LearningItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="190" MinHeight="160" Margin="6" Padding="14"
                                                    Background="{DynamicResource CardAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Symbol}" FontSize="30" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontSize="20"
                                                                   Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Chant}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Margin="0,8,0,5" />
                                                    <TextBlock Grid.Row="2" Text="{Binding CategoryLabel}" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="10" TextWrapping="Wrap" />
                                                    <Grid Grid.Row="3" Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="{loc:Loc '▶  Слушать'}" Tag="{Binding Symbol}"
                                                                Click="LearningCardPlay_OnClick" Padding="10,7" />
                                                        <Button Grid.Column="2" Content="✎" Tag="{Binding Symbol}" Click="LearningCardEdit_OnClick"
                                                                Padding="10,7" ToolTip="{loc:Loc 'Изменить напев'}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="2">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="20" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc 'Сейчас изучаем'}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <Grid Margin="0,8,0,4">
                                        <TextBlock x:Name="LearningNowSymbolText" Text="{loc:Loc 'А'}" FontSize="44" FontWeight="Bold" />
                                        <TextBlock x:Name="LearningNowCodeText" Text=".-" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="28" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="LearningHighlightedChantText" Text="{loc:Loc 'ай-даа'}" FontSize="21" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <TextBlock x:Name="LearningPlaybackStatusText" Text="{loc:Loc 'Выберите карточку'}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{loc:Loc 'Звучание карточки'}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,6" />
                                    <Button x:Name="LearningVoiceModeButton" Content="{loc:Loc 'Голос + сигнал'}" Tag="1" Click="LearningAudioModeButton_OnClick"
                                            Padding="10,7" Margin="0,0,0,6" ToolTip="{loc:Loc 'Сначала напев голосом, затем сигнал с подсветкой слогов'}" />
                                    <Button x:Name="LearningChantModeButton" Content="{loc:Loc 'Напев на экране + сигнал'}" Tag="0" Click="LearningAudioModeButton_OnClick"
                                            Padding="10,7" ToolTip="{loc:Loc 'Только сигнал, слоги напева подсвечиваются на экране'}" />
                                    <TextBlock x:Name="CustomVoiceText" Text=" " Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,10,0,6" />
                                    <WrapPanel>
                                        <Button x:Name="OpenVoiceFolderButton" Content="{loc:Loc 'Папка своего голоса'}" Click="OpenVoiceFolderButton_OnClick"
                                                Padding="10,6" Margin="0,0,8,0"
                                                ToolTip="{loc:Loc 'Положите сюда свои записи напевов: code_01.wav для А (точка — 0, тире — 1). Они заменят встроенный голос.'}" />
                                        <Button x:Name="ResetChantsButton" Content="{loc:Loc 'Вернуть встроенные напевы'}" Click="ResetChantsButton_OnClick"
                                                Padding="10,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- Проверка на слух отдельной вкладкой, как на телефоне: набор, своя скорость, следующий символ сам после ответа -->
            <TabItem Header="{loc:Loc 'На слух'}">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"
                            Padding="24,18" Width="720" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc 'Проверка на слух'}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc 'Прослушайте сигнал и выберите символ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="QuizScoreText" Text="0 / 0" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button x:Name="QuizResetButton" Content="{loc:Loc 'Сбросить счёт'}" Click="QuizResetButton_OnClick" Padding="10,5" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="4" Margin="-3,12,-3,0">
                                <Button x:Name="QuizRussianButton" Content="{loc:Loc 'Русские буквы'}" Tag="0" Click="QuizAlphabetButton_OnClick" Padding="8,8" Margin="3" />
                                <Button x:Name="QuizLatinButton" Content="{loc:Loc 'Латинские буквы'}" Tag="1" Click="QuizAlphabetButton_OnClick" Padding="8,8" Margin="3" />
                                <Button x:Name="QuizBothButton" Content="{loc:Loc 'Русские и латинские'}" Tag="2" Click="QuizAlphabetButton_OnClick" Padding="8,8" Margin="3" />
                                <Button x:Name="QuizDigitsButton" Content="{loc:Loc 'Цифры'}" Tag="3" Click="QuizAlphabetButton_OnClick" Padding="8,8" Margin="3" />
                            </UniformGrid>
                            <Border Background="{DynamicResource CardAltBrush}" CornerRadius="12" Padding="14,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="QuizFrequentText" Text=" " Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"
                                               ToolTip="{loc:Loc 'Символы, которые вы путали, звучат чаще, пока не ответите на них верно'}" />
                                    <TextBlock x:Name="QuizStatusText" Text="{loc:Loc 'Нажмите «Новый символ» и слушайте'}" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <UniformGrid x:Name="QuizAnswersGrid" Columns="2" Margin="-5,0,-5,0">
                                        <Button x:Name="QuizAnswer0Button" Content="?" FontSize="32" Height="68" Margin="5" IsEnabled="False" Click="QuizAnswerButton_OnClick" />
                                        <Button x:Name="QuizAnswer1Button" Content="?" FontSize="32" Height="68" Margin="5" IsEnabled="False" Click="QuizAnswerButton_OnClick" />
                                        <Button x:Name="QuizAnswer2Button" Content="?" FontSize="32" Height="68" Margin="5" IsEnabled="False" Click="QuizAnswerButton_OnClick" />
                                        <Button x:Name="QuizAnswer3Button" Content="?" FontSize="32" Height="68" Margin="5" IsEnabled="False" Click="QuizAnswerButton_OnClick" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="QuizNewButton" Content="{loc:Loc '▶ Новый символ'}" Style="{StaticResource PrimaryButton}" Click="QuizNewButton_OnClick" />
                                <Button x:Name="QuizRepeatButton" Grid.Column="2" Content="{loc:Loc '↻ Ещё раз'}" IsEnabled="False" Click="QuizRepeatButton_OnClick" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc 'Скорость сигнала'}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="QuizSpeedSlider" Grid.Column="2" Minimum="20" Maximum="200" Value="45" TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" ValueChanged="QuizSpeedSlider_OnValueChanged" />
                                <TextBlock x:Name="QuizSpeedValueText" Grid.Column="4" Text=" " MinWidth="92" VerticalAlignment="Center" />
                                <CheckBox x:Name="QuizAutoNextCheckBox" Grid.Column="6" Content="{loc:Loc 'Следующий символ — сразу после ответа'}" IsChecked="True"
                                          VerticalAlignment="Center" Checked="QuizAutoNext_OnChanged" Unchecked="QuizAutoNext_OnChanged" />
                            </Grid>
                            <TextBlock Text="{loc:Loc 'С клавиатуры: символ — ответ, пробел — ещё раз, Enter — новый символ'}"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc 'Передача'}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc 'Передача ключом'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Loc 'Точка — короткое нажатие, тире — втрое длиннее. Пауза в 3 точки завершает символ, в 7 точек — группу. Скорость, алфавит и тон берутся из вкладки «Тренировка».'}"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock x:Name="KeyerTimingText" Text="{loc:Loc 'Точка: 100 мс · тире от 200 мс'}" FontWeight="SemiBold" Margin="0,0,0,16" />

                            <Label Content="{loc:Loc 'Что передавать'}" />
                            <ComboBox x:Name="KeyerModeCombo" SelectedIndex="0" Margin="0,0,0,12"
                                      SelectionChanged="KeyerModeCombo_OnSelectionChanged">
                                <ComboBoxItem Content="{loc:Loc 'Свободная передача'}" />
                                <ComboBoxItem Content="{loc:Loc 'Задание: группы по 5 символов'}" />
                            </ComboBox>
                            <Button x:Name="KeyerNewTaskButton" Content="{loc:Loc 'Новое задание'}" Click="KeyerNewTaskButton_OnClick"
                                    Padding="12,7" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,10" />
                            <TextBlock x:Name="KeyerTargetText" Text="" FontSize="20" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Button x:Name="KeyerCheckButton" Content="{loc:Loc 'Проверить передачу'}" Click="KeyerCheckButton_OnClick"
                                    Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,0,12" />
                            <TextBlock x:Name="KeyerResultText" Text="" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc 'Разбор качества'}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,4" />
                            <TextBlock x:Name="KeyerAnalysisText" Text="{loc:Loc 'Передайте несколько символов и нажмите «Разбор»: отношение тире к точке (норма 3:1), разброс и паузы.'}"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="150" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="KeyPad" Background="{DynamicResource PrimaryDarkBrush}" CornerRadius="18" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="KeyPad_OnMouseDown" PreviewMouseLeftButtonUp="KeyPad_OnMouseUp"
                                    MouseLeave="KeyPad_OnMouseLeave" LostMouseCapture="KeyPad_OnLostMouseCapture">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Loc 'КЛЮЧ'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc 'нажимайте мышью здесь или удерживайте ПРОБЕЛ'}" Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="KeyerCodeText" Grid.Row="2" Text=" " FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBox x:Name="KeyerOutputText" Grid.Row="4" IsReadOnly="True" FontSize="22" FontFamily="Consolas"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Row="6" Orientation="Horizontal">
                                <Button x:Name="KeyerBackspaceButton" Content="{loc:Loc 'Стереть символ'}" Click="KeyerBackspaceButton_OnClick" Padding="12,7" />
                                <Button x:Name="KeyerClearButton" Content="{loc:Loc 'Очистить'}" Click="KeyerClearButton_OnClick" Padding="12,7" Margin="10,0,0,0" />
                                <Button x:Name="KeyerAnalyzeButton" Content="{loc:Loc 'Разбор'}" Click="KeyerAnalyzeButton_OnClick" Padding="12,7" Margin="10,0,0,0"
                                        ToolTip="{loc:Loc 'Отношение тире к точке (норма 3:1), разброс длительностей и паузы внутри символа, между символами и группами.'}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <!-- «Прогресс» виден только с вводом ответа: при записи на бумаге истории нет -->
            <TabItem x:Name="ProgressTab" Header="{loc:Loc 'Прогресс'}" Visibility="Collapsed">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="420" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="420" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc 'История тренировок'}" FontSize="18" FontWeight="SemiBold" />
                            <UniformGrid Grid.Row="2" Columns="4">
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc 'ТРЕНИРОВОК'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="ProgressSessionsText" Text="0" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc 'СРЕДНЯЯ ТОЧНОСТЬ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="ProgressAverageText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc 'ЛУЧШАЯ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="ProgressBestText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc 'ПРИНЯТО СИМВОЛОВ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="ProgressSymbolsText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <ListView x:Name="HistoryListView" Grid.Row="4" Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource TextBrush}" SizeChanged="HistoryListView_OnSizeChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{loc:Loc 'Когда'}" Width="130" DisplayMemberBinding="{Binding When}" />
                                        <GridViewColumn Header="{loc:Loc 'Профиль'}" Width="140" DisplayMemberBinding="{Binding Profile}" />
                                        <GridViewColumn Header="{loc:Loc 'Скорость'}" Width="100" DisplayMemberBinding="{Binding Speed}" />
                                        <GridViewColumn Header="{loc:Loc 'Групп'}" Width="60" DisplayMemberBinding="{Binding Groups}" />
                                        <GridViewColumn Header="{loc:Loc 'Точность'}" Width="80" DisplayMemberBinding="{Binding Accuracy}" />
                                        <GridViewColumn Header="{loc:Loc 'Ошибки'}" Width="180" DisplayMemberBinding="{Binding Errors}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="22,22,10,22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc 'Профиль'}" Foreground="{DynamicResource MutedTextBrush}" />
                            <ComboBox x:Name="ProgressProfileCombo" SelectionChanged="ProgressProfileCombo_OnSelectionChanged" Margin="0,4,0,10" />
                            <WrapPanel Margin="0,0,0,16">
                                <Button x:Name="ExportCsvButton" Content="{loc:Loc 'Экспорт CSV'}" Click="ExportCsvButton_OnClick" Margin="0,0,8,8"
                                        ToolTip="{loc:Loc 'Сохранить видимую историю в CSV для Excel'}" />
                                <Button x:Name="ExportHistoryButton" Content="{loc:Loc 'Экспорт истории…'}" Click="ExportHistoryButton_OnClick" Margin="0,0,8,8"
                                        ToolTip="{loc:Loc 'Вся история (все профили) в файл JSON — чтобы перенести на другой компьютер или телефон'}" />
                                <Button x:Name="ImportHistoryButton" Content="{loc:Loc 'Импорт истории…'}" Click="ImportHistoryButton_OnClick" Margin="0,0,0,8"
                                        ToolTip="{loc:Loc 'Добавить историю из файла JSON с другого устройства; повторы пропускаются'}" />
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc 'Цель в день'}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="DailyGoalCombo" Grid.Column="1" SelectionChanged="DailyGoalCombo_OnSelectionChanged"
                                          ToolTip="{loc:Loc 'Сколько минут в день вы хотите тренироваться. Время задания — от создания до проверки ответа.'}" />
                            </Grid>
                            <TextBlock x:Name="GoalText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <ProgressBar x:Name="GoalProgress" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0" />
                            <TextBlock x:Name="StreakText" Text="—" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
                            <TextBlock Text="{loc:Loc 'По дням'}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc 'точность · заданий · минут; ✓ — цель выполнена'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <StackPanel x:Name="DailyBarsPanel" Margin="0,10,0,0" />
                            <TextBlock Text="{loc:Loc 'Скорость по дням'}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{loc:Loc 'лучшая скорость среди заданий с точностью от 90 %'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <StackPanel x:Name="SpeedBarsPanel" Margin="0,10,0,0" />
                            <TextBlock Text="{loc:Loc 'СЛОЖНЫЕ СИМВОЛЫ ЗА ВСЁ ВРЕМЯ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,18,0,4" />
                            <TextBlock x:Name="HistoryProblemSymbolsText" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc 'ЭКЗАМЕНЫ'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,18,0,4" />
                            <TextBlock x:Name="ExamSeriesText" Text="—" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc 'Результат записывается при первой проверке ответа по каждому заданию. История хранится только на этом компьютере.'}"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
                            <Button x:Name="ClearHistoryButton" Content="{loc:Loc 'Очистить историю'}" Click="ClearHistoryButton_OnClick"
                                    Margin="0,14,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" Text="{loc:Loc 'F5 — слушать    Esc — стоп    Ctrl+G — новое задание    Ctrl+E — экзамен    Ctrl+K — передача    Все данные хранятся только на этом компьютере'}"
                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0"
                   TextWrapping="Wrap" TextAlignment="Center" />
    </Grid>
</Window>
