<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MorseTrainer.Mobile.App">
    <Application.Resources>
        <Color x:Key="Primary">#34D399</Color>
        <Color x:Key="PrimaryDark">#0F766E</Color>
        <Color x:Key="Danger">#EF4444</Color>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F5F9, Dark=#132A26}" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F5F9, Dark=#132A26}" />
        </Style>
        <Style TargetType="Border">
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#CBD5E1, Dark=#27443E}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Application.Resources>
</Application>
