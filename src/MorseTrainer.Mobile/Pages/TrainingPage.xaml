<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MorseTrainer.Mobile.Localization"
             x:Class="MorseTrainer.Mobile.Pages.TrainingPage"
             Title="{loc:Loc 'Тренировка'}">
    <ScrollView>
        <VerticalStackLayout x:Name="RootLayout" Padding="16" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Loc 'Тренировка'}" FontSize="26" FontAttributes="Bold" />
                    <Label x:Name="ProfileLabel" Text="{loc:Loc 'Профиль: Основной'}" Opacity="0.65" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{loc:Loc 'Настроить'}" Clicked="SettingsButton_OnClicked" />
            </Grid>

            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#102F29}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Loc 'Параметры'}" FontAttributes="Bold" />
                    <Label x:Name="SettingsSummaryLabel" Text="{loc:Loc '10 групп × 5 · 60 знаков/мин'}" LineBreakMode="WordWrap" />
                    <Label Text="{loc:Loc 'Перед началом: Ж Ж Ж → пауза → задание'}" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,10,Auto">
                <Button x:Name="GenerateButton" Text="{loc:Loc 'Сгенерировать новое задание'}"
                        BackgroundColor="{StaticResource Primary}" TextColor="#06231C"
                        Clicked="GenerateButton_OnClicked" />
                <Button x:Name="ExamButton" Grid.Column="2" Text="{loc:Loc 'Экзамен'}" Clicked="ExamButton_OnClicked" />
            </Grid>
            <Button x:Name="DrillButton" Text="{loc:Loc 'Повторить сложные символы'}" Clicked="DrillButton_OnClicked" />
            <Label x:Name="ExamLabel" Text="" IsVisible="False" FontAttributes="Bold" HorizontalTextAlignment="Center"
                   TextColor="{StaticResource PrimaryDark}" />

            <Border>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Loc 'Правильный ответ'}" Opacity="0.65" />
                        <Button Grid.Column="1" x:Name="ToggleAnswerButton" Text="{loc:Loc 'Показать'}"
                                Padding="10,6" Clicked="ToggleAnswerButton_OnClicked" />
                    </Grid>
                    <Label x:Name="TaskLabel" Text="••••• •••••" FontSize="22" FontAttributes="Bold"
                           FontFamily="monospace" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,12,*,12,*">
                <Button x:Name="PlayButton" Grid.Column="0" Text="{loc:Loc '▶ Слушать'}"
                        BackgroundColor="{StaticResource Primary}" TextColor="#06231C"
                        Clicked="PlayButton_OnClicked" IsEnabled="False" />
                <Button x:Name="StopButton" Grid.Column="2" Text="{loc:Loc '■ Стоп'}"
                        Clicked="StopButton_OnClicked" IsEnabled="False" />
                <Button x:Name="RepeatButton" Grid.Column="4" Text="{loc:Loc '↻ Ещё раз'}"
                        Clicked="PlayButton_OnClicked" IsEnabled="False" />
            </Grid>
            <Label x:Name="PlaybackStatusLabel" Text="{loc:Loc 'Подготовьте задание'}" HorizontalTextAlignment="Center" Opacity="0.65" />

            <Label Text="{loc:Loc 'Введите услышанные группы'}" FontAttributes="Bold" />
            <Editor x:Name="AnswerEditor" HeightRequest="110" AutoSize="TextChanges"
                    Placeholder="{loc:Loc 'Например: АГЖДЕ БВГДА'}" />
            <Button x:Name="CheckButton" Text="{loc:Loc 'Проверить ответ'}" Clicked="CheckButton_OnClicked" IsEnabled="False" />
            <Border>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="AccuracyLabel" Text="{loc:Loc 'Точность: —'}" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="ResultLabel" Text="{loc:Loc 'Пробелы между группами не учитываются'}" LineBreakMode="WordWrap" />
                    <Label x:Name="HistoryLabel" Text="" Opacity="0.65" LineBreakMode="WordWrap" />
                    <Button x:Name="ExamShareButton" Text="{loc:Loc 'Поделиться протоколом'}" IsVisible="False" Clicked="ExamShareButton_OnClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
