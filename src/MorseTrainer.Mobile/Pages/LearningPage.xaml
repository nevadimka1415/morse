<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MorseTrainer.Mobile.Localization"
             xmlns:domain="clr-namespace:MorseTrainer.Domain;assembly=MorseTrainer.Core"
             x:Class="MorseTrainer.Mobile.Pages.LearningPage"
             Title="{loc:Loc 'Обучение'}">
    <Grid x:Name="RootLayout" Padding="14" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <!-- Шапка в одну строку: карточкам остаётся больше места -->
        <Grid ColumnDefinitions="*,Auto,6,Auto">
            <Label Text="{loc:Loc 'Обучение'}" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />
            <Button x:Name="SearchToggleButton" Grid.Column="1" Text="🔍" Padding="10,6" Clicked="SearchToggleButton_OnClicked" />
            <Button x:Name="CustomVoiceButton" Grid.Column="3" Text="{loc:Loc 'Свой голос…'}" Padding="12,6"
                    Clicked="CustomVoiceButton_OnClicked" />
        </Grid>

        <!-- Курс «С нуля до 60 зн/мин»: кнопки ставят настройки шага и открывают тренировку; подробности — по «▾» -->
        <Border Grid.Row="1" Padding="12,10" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#102F29}">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="CourseTitleLabel" Text="{loc:Loc 'Курс «С нуля до 60 зн/мин»'}" FontAttributes="Bold" LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                    <Button x:Name="CourseDetailsButton" Grid.Column="1" Text="▾" FontSize="18" Padding="10,0" MinimumWidthRequest="36" MinimumHeightRequest="36"
                            VerticalOptions="Start" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryDark}"
                            Clicked="CourseDetailsButton_OnClicked" />
                </Grid>
                <Label x:Name="CourseDetailsLabel" Text="" FontSize="13" Opacity="0.75" LineBreakMode="WordWrap" IsVisible="False" />
                <Button x:Name="CourseBookButton" Text="{loc:Loc '📖 Как устроен курс'}" IsVisible="False" HorizontalOptions="Start" Padding="0,4"
                        BackgroundColor="Transparent" TextColor="{StaticResource PrimaryDark}" Clicked="CourseBookButton_OnClicked" />
                <Label x:Name="CourseStatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap" />
                <Grid ColumnDefinitions="*,6,*,6,Auto">
                    <Button x:Name="CourseStartButton" Text="{loc:Loc 'Начать курс'}" BackgroundColor="{StaticResource Primary}" TextColor="#06231C"
                            Padding="8,7" Clicked="CourseStartButton_OnClicked" />
                    <Button x:Name="CourseNextButton" Grid.Column="2" Text="{loc:Loc 'Следующий шаг'}" Padding="8,7" Clicked="CourseNextButton_OnClicked" />
                    <Button x:Name="CourseResetButton" Grid.Column="4" Text="✕" Padding="10,7" Clicked="CourseResetButton_OnClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Какие символы показать: кнопки вместо выпадающего списка, выбранная подсвечена -->
        <Grid Grid.Row="2" ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto">
            <Button x:Name="AlphabetRussianButton" Text="{loc:Loc 'Русские буквы'}" Padding="6,10" LineBreakMode="WordWrap" CommandParameter="0"
                    Clicked="AlphabetButton_OnClicked" />
            <Button x:Name="AlphabetLatinButton" Grid.Column="2" Text="{loc:Loc 'Латинские буквы'}" Padding="6,10" LineBreakMode="WordWrap" CommandParameter="1"
                    Clicked="AlphabetButton_OnClicked" />
            <Button x:Name="AlphabetBothButton" Grid.Row="2" Text="{loc:Loc 'Русские и латинские'}" Padding="6,10" LineBreakMode="WordWrap" CommandParameter="2"
                    Clicked="AlphabetButton_OnClicked" />
            <Button x:Name="AlphabetDigitsButton" Grid.Row="2" Grid.Column="2" Text="{loc:Loc 'Цифры'}" Padding="6,10" LineBreakMode="WordWrap" CommandParameter="3"
                    Clicked="AlphabetButton_OnClicked" />
        </Grid>
        <SearchBar x:Name="SearchBox" Grid.Row="3" Placeholder="{loc:Loc 'Найти'}" IsVisible="False" TextChanged="SearchBox_OnTextChanged" />

        <CollectionView x:Name="CardsView" Grid.Row="4" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="CardsLayout" Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="domain:LearningSymbolItem">
                    <Border Margin="2" Padding="12">
                        <VerticalStackLayout Spacing="7">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding Symbol}" FontSize="30" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Code}" FontSize="20" TextColor="{StaticResource PrimaryDark}" />
                                <!-- «Изменить напев»: в строке с символом, чтобы кнопки «Голос»/«Сигнал» не обрезались на узкой карточке -->
                                <Button Grid.Column="2" Text="✎" Padding="8,0" Margin="6,0,0,0" MinimumWidthRequest="36" MinimumHeightRequest="36"
                                        VerticalOptions="Start" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryDark}"
                                        CommandParameter="{Binding Symbol}" Clicked="EditChantButton_OnClicked" />
                            </Grid>
                            <Label Text="{Binding Chant}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Text="{loc:Loc 'свой напев'}" IsVisible="{Binding IsCustom}" FontSize="11" Opacity="0.65" />
                            <Label Text="{loc:Loc '🎙 ваш голос'}" IsVisible="{Binding HasOwnVoice}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Grid ColumnDefinitions="*,6,*">
                                <Button Text="{loc:Loc 'Голос'}" Padding="8,7" CommandParameter="{Binding Symbol}"
                                        Clicked="VoiceButton_OnClicked" />
                                <Button Grid.Column="2" Text="{loc:Loc 'Сигнал'}" Padding="8,7" CommandParameter="{Binding Symbol}"
                                        Clicked="SignalButton_OnClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
