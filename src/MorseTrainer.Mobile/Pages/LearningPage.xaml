<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MorseTrainer.Mobile.Localization"
             xmlns:domain="clr-namespace:MorseTrainer.Domain;assembly=MorseTrainer.Core"
             x:Class="MorseTrainer.Mobile.Pages.LearningPage"
             Title="{loc:Loc 'Обучение'}">
    <Grid x:Name="RootLayout" Padding="14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <VerticalStackLayout>
            <Label Text="{loc:Loc 'Обучение'}" FontSize="26" FontAttributes="Bold" />
            <Label Text="{loc:Loc 'Напевы сохранены в приложении и работают без интернета'}" Opacity="0.65" />
            <Button x:Name="CustomVoiceButton" Text="{loc:Loc 'Свой голос…'}" HorizontalOptions="Start" Padding="12,6" Margin="0,6,0,0"
                    Clicked="CustomVoiceButton_OnClicked" />
            <!-- Курс «С нуля до 60 зн/мин»: кнопки ставят настройки шага и открывают тренировку -->
            <Border Margin="0,8,0,0" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#102F29}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="CourseTitleLabel" Text="{loc:Loc 'Курс «С нуля до 60 зн/мин»'}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                    <Label x:Name="CourseDetailsLabel" Text="" FontSize="13" Opacity="0.75" LineBreakMode="WordWrap" />
                    <Label x:Name="CourseStatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,6,*,6,Auto">
                        <Button x:Name="CourseStartButton" Text="{loc:Loc 'Начать курс'}" BackgroundColor="{StaticResource Primary}" TextColor="#06231C"
                                Padding="8,7" Clicked="CourseStartButton_OnClicked" />
                        <Button x:Name="CourseNextButton" Grid.Column="2" Text="{loc:Loc 'Следующий шаг'}" Padding="8,7" Clicked="CourseNextButton_OnClicked" />
                        <Button x:Name="CourseResetButton" Grid.Column="4" Text="✕" Padding="10,7" Clicked="CourseResetButton_OnClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,10,*">
            <Picker x:Name="AlphabetPicker" Title="{loc:Loc 'Алфавит'}" SelectedIndexChanged="Filter_OnChanged" />
            <SearchBar x:Name="SearchBox" Grid.Column="2" Placeholder="{loc:Loc 'Найти'}"
                       TextChanged="Filter_OnChanged" />
        </Grid>

        <CollectionView x:Name="CardsView" Grid.Row="2" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="CardsLayout" Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="domain:LearningSymbolItem">
                    <Border Margin="2" Padding="12">
                        <VerticalStackLayout Spacing="7">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding Symbol}" FontSize="30" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Code}" FontSize="20" TextColor="{StaticResource PrimaryDark}" />
                                <!-- «Изменить напев»: в строке с символом, чтобы кнопки «Голос»/«Сигнал» не обрезались на узкой карточке -->
                                <Button Grid.Column="2" Text="✎" Padding="8,0" Margin="6,0,0,0" MinimumWidthRequest="36" MinimumHeightRequest="36"
                                        VerticalOptions="Start" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryDark}"
                                        CommandParameter="{Binding Symbol}" Clicked="EditChantButton_OnClicked" />
                            </Grid>
                            <Label Text="{Binding Chant}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Text="{loc:Loc 'свой напев'}" IsVisible="{Binding IsCustom}" FontSize="11" Opacity="0.65" />
                            <Grid ColumnDefinitions="*,6,*">
                                <Button Text="{loc:Loc 'Голос'}" Padding="8,7" CommandParameter="{Binding Symbol}"
                                        Clicked="VoiceButton_OnClicked" />
                                <Button Grid.Column="2" Text="{loc:Loc 'Сигнал'}" Padding="8,7" CommandParameter="{Binding Symbol}"
                                        Clicked="SignalButton_OnClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#102F29}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="{loc:Loc 'Проверка на слух'}" FontAttributes="Bold" FontSize="17" />
                        <Label x:Name="QuizStatusLabel" Text="{loc:Loc 'Прослушайте сигнал и выберите символ'}" Opacity="0.65" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{loc:Loc 'Новое'}" Clicked="QuizButton_OnClicked" />
                </Grid>
                <FlexLayout x:Name="QuizAnswers" Direction="Row" Wrap="Wrap" JustifyContent="SpaceAround" />
                <Label x:Name="QuizScoreLabel" Text="{loc:Loc 'Результат: 0 / 0'}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
