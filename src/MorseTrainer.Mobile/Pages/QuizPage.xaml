<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MorseTrainer.Mobile.Localization"
             x:Class="MorseTrainer.Mobile.Pages.QuizPage"
             Title="{loc:Loc 'На слух'}">
    <!-- Проверка на слух отдельной вкладкой: на «Обучении» она занимала место карточек -->
    <ScrollView>
        <VerticalStackLayout x:Name="RootLayout" Padding="16" Spacing="14">
            <VerticalStackLayout>
                <Label Text="{loc:Loc 'Проверка на слух'}" FontSize="26" FontAttributes="Bold" />
                <Label Text="{loc:Loc 'Прослушайте сигнал и выберите символ'}" Opacity="0.65" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto">
                <Button x:Name="AlphabetRussianButton" Padding="6,10" LineBreakMode="WordWrap" Text="{loc:Loc 'Русские буквы'}" CommandParameter="0" Clicked="AlphabetButton_OnClicked" />
                <Button x:Name="AlphabetLatinButton" Padding="6,10" LineBreakMode="WordWrap" Grid.Column="2" Text="{loc:Loc 'Латинские буквы'}" CommandParameter="1" Clicked="AlphabetButton_OnClicked" />
                <Button x:Name="AlphabetBothButton" Padding="6,10" LineBreakMode="WordWrap" Grid.Row="2" Text="{loc:Loc 'Русские и латинские'}" CommandParameter="2" Clicked="AlphabetButton_OnClicked" />
                <Button x:Name="AlphabetDigitsButton" Padding="6,10" LineBreakMode="WordWrap" Grid.Row="2" Grid.Column="2" Text="{loc:Loc 'Цифры'}" CommandParameter="3" Clicked="AlphabetButton_OnClicked" />
            </Grid>

            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#102F29}">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="QuizStatusLabel" Text="{loc:Loc 'Нажмите «Новый символ» и слушайте'}" FontSize="17" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,10,Auto">
                        <Button x:Name="Answer0Button" Text="?" FontSize="30" HeightRequest="76" IsEnabled="False" Clicked="AnswerButton_OnClicked" />
                        <Button x:Name="Answer1Button" Grid.Column="2" Text="?" FontSize="30" HeightRequest="76" IsEnabled="False" Clicked="AnswerButton_OnClicked" />
                        <Button x:Name="Answer2Button" Grid.Row="2" Text="?" FontSize="30" HeightRequest="76" IsEnabled="False" Clicked="AnswerButton_OnClicked" />
                        <Button x:Name="Answer3Button" Grid.Row="2" Grid.Column="2" Text="?" FontSize="30" HeightRequest="76" IsEnabled="False" Clicked="AnswerButton_OnClicked" />
                    </Grid>
                    <Label x:Name="QuizScoreLabel" Text="{loc:Loc 'Результат: 0 / 0'}" HorizontalTextAlignment="Center" />
                    <!-- Символы, которые путали: звучат чаще, пока не ответите на них верно -->
                    <Label x:Name="QuizFrequentLabel" Text="" IsVisible="False" HorizontalTextAlignment="Center" FontSize="13" Opacity="0.7" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,10,*">
                <Button x:Name="NewButton" Text="{loc:Loc '▶ Новый символ'}" BackgroundColor="{StaticResource Primary}" TextColor="#06231C"
                        Clicked="NewButton_OnClicked" />
                <Button x:Name="RepeatButton" Grid.Column="2" Text="{loc:Loc '↻ Ещё раз'}" IsEnabled="False" Clicked="RepeatButton_OnClicked" />
            </Grid>
            <!-- Скорость сигнала своя (кому-то медленнее, кому-то быстрее); следующий символ звучит сам после ответа -->
            <Border>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Loc 'Скорость сигнала'}" VerticalOptions="Center" />
                        <Label x:Name="SpeedValueLabel" Grid.Column="1" Text="" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Slider x:Name="SpeedSlider" Minimum="20" Maximum="200" Value="45" ValueChanged="SpeedSlider_OnValueChanged" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Loc 'Следующий символ — сразу после ответа'}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Switch x:Name="AutoNextSwitch" Grid.Column="1" Toggled="AutoNextSwitch_OnToggled" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Button x:Name="ResetScoreButton" Text="{loc:Loc 'Сбросить счёт'}" HorizontalOptions="Center" BackgroundColor="Transparent"
                    TextColor="{StaticResource PrimaryDark}" Clicked="ResetScoreButton_OnClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
