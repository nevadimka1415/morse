<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MorseTrainer.Mobile.Localization"
             xmlns:models="clr-namespace:MorseTrainer.Models;assembly=MorseTrainer.Core"
             x:Class="MorseTrainer.Mobile.Pages.ProgressPage"
             Title="{loc:Loc 'Прогресс'}">
    <ScrollView>
        <VerticalStackLayout x:Name="RootLayout" Padding="16" Spacing="14">
            <Label Text="{loc:Loc 'Прогресс'}" FontSize="26" FontAttributes="Bold" />

            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#102F29}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="SummaryLabel" Text="{loc:Loc 'Тренировок пока нет'}" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="DetailsLabel" Text="{loc:Loc 'Проверьте ответ в тренировке, и результат появится здесь.'}" LineBreakMode="WordWrap" />
                    <Label x:Name="ProblemSymbolsLabel" Text="" LineBreakMode="WordWrap" />
                    <Label x:Name="ExamSeriesLabel" Text="" LineBreakMode="WordWrap" Opacity="0.8" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Loc 'Цель в день'}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Picker x:Name="GoalPicker" Grid.Column="1" MinimumWidthRequest="110" SelectedIndexChanged="GoalPicker_OnChanged" />
                    </Grid>
                    <Label x:Name="GoalLabel" Text="" LineBreakMode="WordWrap" />
                    <ProgressBar x:Name="GoalBar" Progress="0" ProgressColor="{StaticResource Primary}" />
                    <Label x:Name="StreakLabel" Text="" Opacity="0.65" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout x:Name="DailyLayout" Spacing="6">
                    <Label Text="{loc:Loc 'По дням'}" FontAttributes="Bold" />
                    <Label Text="{loc:Loc 'точность · заданий · минут; ✓ — цель выполнена'}" Opacity="0.65" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout x:Name="SpeedLayout" Spacing="6">
                    <Label Text="{loc:Loc 'Скорость по дням'}" FontAttributes="Bold" />
                    <Label Text="{loc:Loc 'лучшая скорость среди заданий с точностью от 90 %'}" Opacity="0.65" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Loc 'Последние тренировки'}" FontAttributes="Bold" />
                    <CollectionView x:Name="HistoryView" SelectionMode="None" HeightRequest="360">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrainingRecord">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding CompletedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
                                        <Label Text="{Binding ProfileName}" Opacity="0.65" FontSize="13" />
                                        <Label Text="{Binding Kind}" IsVisible="{Binding HasKind}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AccuracyPercent, StringFormat='{0:0.#}%'}"
                                           FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,8,*">
                <Button Text="{loc:Loc 'Поделиться CSV'}" Clicked="ShareCsvButton_OnClicked" />
                <Button Grid.Column="2" Text="{loc:Loc 'Очистить историю'}" Clicked="ClearButton_OnClicked" />
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
                <Button x:Name="ShareHistoryButton" Text="{loc:Loc 'Поделиться историей'}" Clicked="ShareHistoryButton_OnClicked" />
                <Button x:Name="ImportHistoryButton" Grid.Column="2" Text="{loc:Loc 'Импорт истории'}" Clicked="ImportHistoryButton_OnClicked" />
            </Grid>
            <Label Text="{loc:Loc '«Поделиться историей» отправляет файл JSON со всеми тренировками (например, себе в мессенджер); «Импорт истории» добавляет записи из такого файла или из буфера обмена, повторы пропускаются.'}"
                   Opacity="0.65" FontSize="13" LineBreakMode="WordWrap" />
            <Label Text="{loc:Loc 'История хранится только на этом устройстве.'}" HorizontalTextAlignment="Center" Opacity="0.65" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
