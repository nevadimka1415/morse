<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MorseTrainer.Mobile.Localization"
             xmlns:models="clr-namespace:MorseTrainer.Models;assembly=MorseTrainer.Core"
             x:Class="MorseTrainer.Mobile.Pages.ProgressPage"
             Title="{loc:Loc 'Прогресс'}">
    <ScrollView>
        <VerticalStackLayout x:Name="RootLayout" Padding="16" Spacing="14">
            <Label Text="{loc:Loc 'Прогресс'}" FontSize="26" FontAttributes="Bold" />
            <Picker x:Name="ProfilePicker" Title="{loc:Loc 'Профиль'}" SelectedIndexChanged="ProfilePicker_OnChanged" />

            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#102F29}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="SummaryLabel" Text="{loc:Loc 'Тренировок пока нет'}" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="DetailsLabel" Text="{loc:Loc 'Проверьте ответ в тренировке, и результат появится здесь.'}" LineBreakMode="WordWrap" />
                    <Label x:Name="ProblemSymbolsLabel" Text="" LineBreakMode="WordWrap" />
                    <Label x:Name="ExamSeriesLabel" Text="" LineBreakMode="WordWrap" Opacity="0.8" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout x:Name="DailyLayout" Spacing="6">
                    <Label Text="{loc:Loc 'По дням'}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Loc 'Последние тренировки'}" FontAttributes="Bold" />
                    <CollectionView x:Name="HistoryView" SelectionMode="None" HeightRequest="360">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrainingRecord">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding CompletedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
                                        <Label Text="{Binding ProfileName}" Opacity="0.65" FontSize="13" />
                                        <Label Text="{Binding Kind}" IsVisible="{Binding IsExam}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AccuracyPercent, StringFormat='{0:0.#}%'}"
                                           FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,8,*">
                <Button Text="{loc:Loc 'Поделиться CSV'}" Clicked="ShareCsvButton_OnClicked" />
                <Button Grid.Column="2" Text="{loc:Loc 'Очистить историю'}" Clicked="ClearButton_OnClicked" />
            </Grid>
            <Label Text="{loc:Loc 'История хранится только на этом устройстве.'}" HorizontalTextAlignment="Center" Opacity="0.65" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
