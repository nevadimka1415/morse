<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- android:icon обязателен: без него лаунчер показывает стандартный значок Android, хотя картинки (MauiIcon)
         в APK лежат. RuStore требует, чтобы иконка на телефоне совпадала с иконкой карточки -->
    <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Только для кнопки «Проверить обновления» (GitHub Releases) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Напоминание о тренировке: уведомления (Android 13+) и восстановление будильника после перезагрузки -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Запись своих напевов с микрофона (страница «Обучение») -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
