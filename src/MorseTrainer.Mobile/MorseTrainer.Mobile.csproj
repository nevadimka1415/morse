<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <!-- Один TFM на раннер: Windows собирает только Android, macOS только iOS. Задаётся снаружи через
         -p:MobileTargetFrameworks=..., а не -p:TargetFrameworks: глобальное свойство утекает
         в MorseTrainer.Core (обычная библиотека net10.0) и ломает его restore (NETSDK1005) -->
    <TargetFrameworks Condition="'$(MobileTargetFrameworks)' != ''">$(MobileTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MorseTrainer.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Morse Trainer</ApplicationTitle>
    <ApplicationId>ru.morsetrainer.app</ApplicationId>
    <ApplicationDisplayVersion>2.6.0</ApplicationDisplayVersion>
    <!-- versionCode = major*10000 + minor*100 + patch, как считает release.yml из тега -->
    <ApplicationVersion>20600</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- R8 обрезает неиспользуемый Java-код: APK меньше -->
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#0F766E" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#071A17" BaseSize="256,256" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Начиная с .NET 9 workload MAUI не подключает пакет Controls неявно — ссылка обязательна -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MorseTrainer.Core/MorseTrainer.Core.csproj" />
  </ItemGroup>
</Project>
